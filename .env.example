# Gemini - required for discovery and evaluation agents
GOOGLE_API_KEY=your_gemini_api_key
# or: GEMINI_API_KEY=your_gemini_api_key

# Supabase - required for all data persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Serper - required for candidate discovery (web search)
# Get a free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key

# GitHub - optional, raises rate limit from 60 to 5000 req/hr
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# Cloudflare Browser Rendering - optional, for crawling personal sites/blogs
# Free tier: 10 min/day. Create a token with "Browser Rendering - Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Datablist - optional, for LinkedIn profile data without ban risk
# Sign up at https://datablist.com
DATABLIST_API_KEY=
