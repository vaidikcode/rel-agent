# Gemini - required for discovery and evaluation agents
GOOGLE_API_KEY=your_gemini_api_key
# or: GEMINI_API_KEY=your_gemini_api_key

# Supabase - required for all data persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Serper - required for candidate discovery (web search)
# Get a free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key
