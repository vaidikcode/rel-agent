# Frontend (Vite) - optional; API base is proxied to /api in dev
# VITE_API_URL=/api

# Backend (FastAPI) - required for evaluate/ranking
GOOGLE_API_KEY=your_gemini_api_key
# or: GEMINI_API_KEY=your_gemini_api_key

# Supabase - required for saving candidates and ranking
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
